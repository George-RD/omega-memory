  "context_overrides": {
    "large_context": {
      "threshold_tokens": 100000,
      "model": {
        "provider": "google",
        "model": "gemini-3-flash-preview",
        "reason": "Gemini 3 Flash — 1M context window, fast inference at $0.50/$3",
        "context_window": 1000000
      }
    }
  },
  "priority_modes": {
    "cost": {
      "prefer_models": [
        "llama-3.1-8b-instant",
        "grok-4.1-fast",
        "gemini-3-flash-preview",
        "claude-haiku-4-5-20251001",
        "gemini-3-pro-preview"
      ],
      "description": "Minimize cost: Groq 8B ($0.05/M) → Grok 4.1 Fast ($0.20/M) → Gemini 3 Flash ($0.50/M) → Haiku ($1/M) → Gemini 3 Pro ($2/M)",
      "strategy": "cheapest_first"
    },
    "speed": {
      "prefer_models": [
        "llama-3.1-8b-instant",
        "grok-4.1-fast",
        "gemini-3-flash-preview",
        "llama-3.3-70b-versatile",
        "claude-haiku-4-5-20251001"
      ],
      "description": "Minimize latency: Groq 8B → Grok 4.1 Fast → Gemini 3 Flash → Groq 70B → Haiku",
      "strategy": "lowest_latency"
    },
    "quality": {
      "prefer_models": [
        "claude-opus-4-6",
        "gpt-5.2",
        "claude-sonnet-4-5-20250929",
        "grok-4-latest"
      ],
      "description": "Maximize quality: Opus 4.6 → GPT-5.2 → Sonnet 4.5 → Grok 4",
      "strategy": "highest_capability"
    },
    "balanced": {
      "prefer_models": [
        "claude-sonnet-4-5-20250929",
        "gpt-5.2",
        "grok-4-latest",
        "gemini-3-pro-preview",
        "claude-haiku-4-5-20251001"
      ],
      "description": "Balance cost and quality: Sonnet 4.5 → GPT-5.2 → Grok 4 → Gemini 3 Pro → Haiku",
      "strategy": "cost_quality_ratio"
    }
  },
  "providers": {
    "anthropic": {
      "base_url": "https://api.anthropic.com",
      "env_key": "ANTHROPIC_API_KEY",
      "status": "healthy"
    },
    "openai": {
      "base_url": "https://api.openai.com/v1",
      "env_key": "OPENAI_API_KEY",
      "status": "healthy"
    },
    "google": {
      "base_url": "https://generativelanguage.googleapis.com",
      "env_key": "GOOGLE_API_KEY",
      "status": "healthy"
    },
    "groq": {
      "base_url": "https://api.groq.com/openai/v1",
      "env_key": "GROQ_API_KEY",
      "status": "healthy",
      "openai_compatible": true
    },
    "xai": {
      "base_url": "https://api.x.ai/v1",
      "env_key": "XAI_API_KEY",
      "status": "healthy",
      "openai_compatible": true
    }
  },
