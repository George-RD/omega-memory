  "intent_routing": {
    "coding": {
      "primary": {
        "provider": "anthropic",
        "model": "claude-opus-4-6",
        "reason": "Strongest coding model — deep reasoning + tool use",
        "context_window": 200000,
        "cost_per_1m_input": 5.0,
        "cost_per_1m_output": 25.0
      },
      "fallback": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-5-20250929",
        "reason": "Best coding cost/quality ratio, same provider for seamless fallback"
      }
    },
    "creative": {
      "primary": {
        "provider": "anthropic",
        "model": "claude-opus-4-6",
        "reason": "Best creative writing capability",
        "context_window": 200000,
        "cost_per_1m_input": 5.0,
        "cost_per_1m_output": 25.0
      },
      "fallback": {
        "provider": "openai",
        "model": "gpt-5.2",
        "reason": "GPT-5.2 strong creative + 400K context at $1.75/$14"
      }
    },
    "logic": {
      "primary": {
        "provider": "anthropic",
        "model": "claude-opus-4-6",
        "reason": "Deep reasoning capability",
        "context_window": 200000,
        "cost_per_1m_input": 5.0,
        "cost_per_1m_output": 25.0
      },
      "fallback": {
        "provider": "google",
        "model": "gemini-3-pro-preview",
        "reason": "Gemini 3 Pro advanced reasoning, 1M context"
      }
    },
    "exploration": {
      "primary": {
        "provider": "xai",
        "model": "grok-4-latest",
        "reason": "Real-time web access, strong research and AI trend awareness",
        "context_window": 256000,
        "cost_per_1m_input": 3.0,
        "cost_per_1m_output": 15.0
      },
      "fallback": {
        "provider": "xai",
        "model": "grok-4.1-fast",
        "reason": "2M context, budget-friendly exploration at $0.20/$0.50 per 1M tokens"
      }
    },
    "simple_edit": {
      "primary": {
        "provider": "groq",
        "model": "llama-3.1-8b-instant",
        "reason": "Groq LPU inference — fastest and cheapest for trivial edits",
        "context_window": 128000,
        "cost_per_1m_input": 0.05,
        "cost_per_1m_output": 0.08
      },
      "fallback": {
        "provider": "google",
        "model": "gemini-3-flash-preview",
        "reason": "Gemini 3 Flash — 1M context fallback at $0.50/$3"
      }
    },
    "image": {
      "primary": {
        "provider": "google",
        "model": "gemini-3-pro-image-preview",
        "reason": "Nano Banana Pro — best-in-class image generation with text rendering and 4K output",
        "context_window": 1000000,
        "cost_per_1m_input": 2.0,
        "cost_per_1m_output": 8.0
      },
      "fallback": {
        "provider": "google",
        "model": "gemini-3-pro-preview",
        "reason": "Gemini 3 Pro multimodal fallback"
      }
    }
